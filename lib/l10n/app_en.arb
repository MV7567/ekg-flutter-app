  "instrSafetyTitle": "Safety",
  "instrSafety1": "This is a student project, not a medical device. Do not use it for diagnosis.",
  "instrSafety2": "Power the board from a battery or a laptop running on battery, never from a wall charger while the electrodes are on the body.",
  "instrSafety3": "Stop if the skin under an electrode itches or burns.",
  "instrElectrodesTitle": "1. Electrodes",
  "instrElectrodesIntro": "Three electrodes, the cable labels say which one is which:",
  "instrRightArm": "Right arm",
  "instrRightArmWhere": "right wrist or below the right collarbone",
  "instrLeftArm": "Left arm",
  "instrLeftArmWhere": "left wrist or below the left collarbone",
  "instrLeftLeg": "Left leg",
  "instrLeftLegWhere": "left side of the belly, below the heart, or the left ankle",
  "instrFrontView": "Seen from the front: the right arm of the person is on the LEFT of the picture.",
  "instrSkinTitle": "2. Skin",
  "instrSkin1": "Clean and dry skin, an alcohol wipe helps. No cream or lotion.",
  "instrSkin2": "Fresh gel electrodes, an old dry one gives a noisy line.",
  "instrSkin3": "Not on hair, bone or a tense muscle. Press the edges down well.",
  "instrDuringTitle": "3. During the measurement",
  "instrDuring1": "Sit or lie down, relax, arms resting. Do not talk or move.",
  "instrDuring2": "Keep the phone, chargers and power cables away from the cables (50 Hz hum).",
  "instrDuring3": "Wait about 10 s after pressing START, the line needs a moment to settle.",
  "instrDuring4": "Spikes pointing DOWN usually mean RA and LA are swapped.",
  "instrLengthTitle": "4. How long to record",
  "instrLength1": "10 s: a quick look, the same length as a hospital 12-lead ECG.",
  "instrLength2": "30 s – 1 min: recommended, enough beats to see the rhythm.",
  "instrLength3": "5 min: for heart rate variability (HRV) analysis.",
  "instrLength4": "Choose the length next to the START button, the recording stops by itself."
